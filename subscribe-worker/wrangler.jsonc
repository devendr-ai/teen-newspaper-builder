{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "newspebbles-subscribe",
  "main": "src/index.js",
  "compatibility_date": "2026-10-25",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "newspebbles-subscriptions",
      "database_id": "00000000-0000-0000-0000-000000000000",
    },
  ],
  "vars": {
    "PUBLIC_BASE_URL": "https://replace-with-your-worker.workers.dev",
    "RESEND_FROM": "News Pebbles <papers@mail.newspebbles.com>",
    "DELIVERY_ENABLED": "false",
    "WEEKEND_TIMEZONE": "America/Los_Angeles",
    "DAILY_EMAIL_LIMIT": "90",
  },
  // Enable only after domain verification, secrets and a test delivery:
  "triggers": { "crons": [] },
}
